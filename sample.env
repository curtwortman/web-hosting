GEMINI_API_KEY=your_gemini_api_key_here
PROJECT=wortman-website
PORT=8000
VIXCI_UTILS_DIR=/path/to/vixci-utils

# ── Google OAuth2 ──────────────────────────────────────────────────────────
# Get these from https://console.cloud.google.com → APIs → Credentials → OAuth 2.0
# Set Authorized redirect URI to: http://localhost:8000/auth/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ── Access Control ─────────────────────────────────────────────────────────
# Comma-separated list of Google emails that receive role=family
FAMILY_EMAILS=family1@example.com,family2@example.com

# Comma-separated list of emails that receive role=admin (optional)
ADMIN_EMAILS=admin@example.com

# ── Session Security ───────────────────────────────────────────────────────
# Random 32+ char string. Change this in production!
SECRET_KEY=your_secret_key_here
